		end
	else
		InvButton.Text = "View Inventories: OFF"
		InvButton.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
		for _, player in ipairs(Players:GetPlayers()) do
			removeInventoryBillboard(player)
		end
	end
end)

